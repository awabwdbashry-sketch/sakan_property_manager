# ملفات خاصة: لا وصول مباشر عبر المتصفح، التنزيل يتم فقط عبر file.php بعد التحقق من الصلاحية
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
php_flag engine off
